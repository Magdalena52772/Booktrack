/* ================
Book Track Admin Panel Stylesheet
Author: Magdalena Popczyk
================*/

/* GLOBAL */
QMainWindow {
    background-color: #f5f3f1;
    font-family: "Segoe UI", "Arial", sans-serif;
}

/* SIDEBAR */
QWidget#Sidebar {
    background-color: #4A2E2A;
    padding: 12px 10px;
    color: #fff;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
}

QLabel#lbl_account_info {
    font-size: 14px;
    font-weight: 600;
    color: #faf6f4;
    margin-bottom: 14px;
    padding: 0 10px;
}

QPushButton.sidebarButton {
    background-color: transparent;
    padding: 10px 18px;
    text-align: left;
    color: #fff;
    font-size: 12px;
    border-radius: 8px;
}

QPushButton.sidebarButton:hover {
    background-color: rgba(255, 255, 255, 0.12);
    padding-left: 24px;
}

QPushButton.sidebarButton:checked {
    background-color: rgba(255, 255, 255, 0.2);
    border-left: 3px solid #e7c3a9;
    font-weight: 700;
    padding-left: 26px;
}

/* TOPBAR */
QWidget#Topbar {
    padding: 6px 14px;
    background-color: #ffffff;
    border-bottom: 1px solid #e3dcd6;
}

/* Przycisk Logout */
QPushButton#btn_logout {
    background-color: #6d3b2f;
    padding: 8px 20px; 
    max-width: 120px;  
    color: #fff;
    border-radius: 10px;
    font-weight: 600;
}

QPushButton#btn_logout:hover {
    background-color: #874b3c;
}

/* MAIN CONTENT */
QFrame#MainContent {
    background-color: #ffffff;
    border-radius: 15px;
    margin: 12px;
    padding: 22px;
    border: 1px solid #e9e2dc;
}

/* PAGE TITLE */
QLabel#lbl_title {
    font-size: 24px;
    font-weight: 800;
    color: #4A2E2A;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid #e9e2dc;
}

/* PRZYCISKI */
QPushButton {
    background-color: #6B2F2F;
    color: #fff;
    font-size: 12px;
    padding: 10px 25px;
    max-width: 200px;
    border-radius: 10px;
    border: none;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #7f3a3a;
}

QPushButton:pressed {
    background-color: #552323;
}

/* INPUTS */
QLineEdit, QComboBox, QTextEdit {
    border: 1px solid #cfc6c2;
    border-radius: 8px;
    background-color: #fdfdfd;
    padding: 8px 12px;
    font-size: 12px;
}

QLineEdit:focus, QComboBox:focus, QTextEdit:focus {
    border: 1px solid #b79578;
    background-color: #ffffff;
}

/* FORM LABELS */
QLabel#lbl_info, QLabel#lbl_info1, QLabel#lbl_desc, QLabel#lbl_desc1 {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #8c7e7a;
    padding-left: 2px;
    border: none;
    margin-top: 10px;
    margin-bottom: 4px;
}

/* TABLE */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #d7cfc9;
    border-radius: 8px;
    gridline-color: #f0edea;
    font-size: 12px;
    selection-background-color: #f2e9e4;
    selection-color: #4A2E2A;
}

QHeaderView::section {
    background-color: transparent;
    color: #8c7e7a;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 10px;
    letter-spacing: 1px;
    padding: 10px;
    border: none;
    border-bottom: 1px solid #dbd2cd;
}

/* METRICS */
#frame_metrics QLabel {
    background-color: #ffffff;
    border: 1px solid #e3dcd6;
    qproperty-alignment: 'AlignCenter';
    padding: 40px 20px;
    margin: 0 30px; 
    font-family: "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 600; 
    color: #4A2E2A; 
    border-radius: 16px;
    
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, 
                       stop:0 #ffffff, 
                       stop:0.8 #ffffff, 
                       stop:1.0 #fcf8f2);
}

#frame_metrics QLabel:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, 
                       stop:0 #ffffff, 
                       stop:0.4 #ffffff, 
                       stop:1.0 #efdfca); 
    border-color: #d4a34d;
}

#frame_metrics QLabel[objectName^="lbl_val"] {
    font-size: 22px;
    font-weight: 800;
    color: #d4a34d; 
    background-color: transparent;
}

/* CHART DESCRIPTION */
QLabel#lbl_chart_desc {
    font-size: 12px;
    font-weight: 600;
    color: #514341;
    padding-left: 8px;
    border-left: 3px solid rgba(107, 47, 47, 0.4);
    margin-top: 8px;
    margin-bottom: 8px;
}

/* STATUS BAR */
QStatusBar {
    background-color: #f4f1ef;
    border-top: 1px solid #dbd5d0;
    padding: 8px 12px;
    color: #3a3a3a;
    font-size: 13px;
    font-weight: 700;
}

/* STATUS COLORS */
QStatusBar[statusType="info"]    { color: #1E3A8A; }
QStatusBar[statusType="warning"] { color: #B45309; }
QStatusBar[statusType="success"] { color: #15803D; }
QStatusBar[statusType="error"]   { color: #B91C1C; }